# LOCAL DEVELOPMENT ONLY. These public, fake credentials are not production secrets.
# No preparation is required to use the same defaults: docker compose up --build
# Optional custom values: copy THIS file to .env.docker (never overwrite root .env),
# then run: docker compose --env-file .env.docker up --build --wait
# .env.docker is ignored by Git. Never commit private values.
# Only DOCKER_* variables customize the stack; existing application .env values
# such as DATABASE_URL, GOOGLE_CLIENT_ID and EMAIL_HOST are not inherited.
# Project: soma-learn-local-dev. Requires free host ports 5174, 8001, 1027, 8027.
# Never stop/delete older projects to resolve conflicts without owner approval.
# Frontend http://localhost:5174 ; admin http://localhost:8001/admin/
# Mailpit http://localhost:8027 ; host SMTP 127.0.0.1:1027 (no auth/TLS).
# DB has no host port. No Google credentials are configured.
# Admin is created by existing users post_migrate hook, NOT reset on restart.
# DB credentials must remain unchanged after first initialization of the volume.
# Preserve data: docker compose down (NEVER add -v), then docker compose up --wait
# Use the same --env-file option on all commands if you created .env.docker.
DOCKER_POSTGRES_DB=soma_local
DOCKER_POSTGRES_USER=soma_local
DOCKER_POSTGRES_PASSWORD=local-only-db-password
DOCKER_SECRET_KEY=local-only-not-for-production-secret-key
DOCKER_SUPERUSER_EMAIL=admin@soma-learn.local
DOCKER_SUPERUSER_PASSWORD=Local-Only-Admin-482!
DOCKER_SUPERUSER_FIRST_NAME=Local
DOCKER_SUPERUSER_LAST_NAME=Admin
