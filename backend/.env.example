SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=False
FRONTEND_BASE_URL=http://localhost:5173

# Optional PostgreSQL URL; when set, it takes precedence over POSTGRES_* below.
DATABASE_URL=

POSTGRES_DB=soma
POSTGRES_USER=soma_user
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Host backend with Mailpit (docker compose up -d mailpit): EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, EMAIL_HOST=localhost, EMAIL_PORT=1027, EMAIL_USE_TLS=False; UI at http://localhost:8027
# Dockerized backend uses mailpit:1025. Compose sets its environment directly;
# this file documents backend settings for running without containers.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com

SUPERUSER_EMAIL=admin@soma-learn.local
SUPERUSER_PASSWORD=replace-with-a-local-admin-password
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=Soma
