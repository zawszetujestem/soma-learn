# Reference template only. Django loads backend/.env, not this file.
# Keep real credentials in backend/.env and do not commit that file.
# Replace the placeholder values below with your local settings.

# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set True to use backend/db.sqlite3 instead of PostgreSQL.
USE_SQLITE=False

# Use DATABASE_URL or the POSTGRES_* fields below. DATABASE_URL takes precedence.
# URL-encode special characters in the username/password (for example, @ as %40).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Alternative PostgreSQL settings. These must match the local role/database.
POSTGRES_DB=soma_learn
POSTGRES_USER=soma
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional local admin account created by the project after migrations.
SUPERUSER_EMAIL=admin@soma-learn.local
SUPERUSER_PASSWORD=replace-with-a-local-admin-password
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=Soma